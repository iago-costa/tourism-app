# Copie para .env.prod no manager (vm-01) — não versionar .env.prod.
# Usado por: task deploy:prod, scripts/deploy-prod.sh
# O docker compose interpola estas variáveis em docker-compose.prod.yml.

POSTGRES_DB=tourism
POSTGRES_USER=tourism
POSTGRES_PASSWORD=

# Obrigatório — compose falha sem isso
JWT_SECRET_KEY=

# Réplica Postgres (db-standby) — opcional em single-node
REPL_USER=replicator
REPL_PASSWORD=

# Imagens (defaults no compose; deploy-prod.sh exporta APP_IMAGE_* após build local)
# APP_IMAGE_BACKEND=ghcr.io/iago-costa/tourism-app-backend:latest
# APP_IMAGE_FRONTEND=ghcr.io/iago-costa/tourism-app-frontend:latest

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
