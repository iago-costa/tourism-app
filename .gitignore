# ==========================================
# Monorepo .gitignore — Tourism App
# ==========================================

# ----- OS -----
.DS_Store
Thumbs.db

# ----- IDE -----
.idea/
.vscode/
*.swp
*.swo

# ----- Frontend (React Native) -----
frontend-react-native/node_modules/
frontend-react-native/npm-debug.log
frontend-react-native/yarn-error.log
frontend-react-native/.metro-health-check*
frontend-react-native/coverage/

# Xcode
frontend-react-native/ios/build/
frontend-react-native/ios/Pods/
frontend-react-native/ios/DerivedData/
frontend-react-native/ios/**/*.xcuserstate
frontend-react-native/ios/**/xcuserdata/
frontend-react-native/ios/**/.xcode.env.local

# Android
frontend-react-native/android/build/
frontend-react-native/android/app/build/
frontend-react-native/android/.gradle/
frontend-react-native/android/local.properties
frontend-react-native/android/*.hprof
frontend-react-native/android/.cxx/
frontend-react-native/android/.kotlin/

# Bundle
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Fastlane
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ----- Backend (Python) -----
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
backend/tourism.db
backend/.mypy_cache/
backend/.pytest_cache/

# ----- Secrets / Keystores -----
*.keystore
!debug.keystore
*.jks
*.p12
*.mobileprovision
*.cer
google-play-service-account.json
